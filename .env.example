# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Postgres (docker-compose.yml). Host port 5433 avoids clashing with other local Postgres.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://copilot:copilot-dev-only@localhost:5433/copilot

# Floci (local AWS emulator). Any non-empty credentials work.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Cost guardrail. Leave false. True allows real, billable AWS.
ALLOW_REAL_AWS=false

# LLM providers (free tiers), from M3 onward.
GROQ_API_KEY=
GEMINI_API_KEY=
