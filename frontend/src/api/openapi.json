                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set User Active",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/users/{email}/groups": {
      "put": {
        "operationId": "set_user_groups_api_admin_users__email__groups_put",
        "parameters": [
          {
            "in": "path",
