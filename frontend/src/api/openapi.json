    "/health": {
      "get": {
        "description": "Report whether the API can reach its dependencies.\n\nReturns 200 when all dependencies are reachable, otherwise 503. A deploy script or load\nbalancer can then tell \"process running\" apart from \"able to serve\".\nThe blocking DB and boto3 calls run in a thread pool so they don't stall the event loop.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
